{
    "compilerOptions": {
      "target": "ESNext",
      "module": "ESNext",
      "moduleResolution": "Node",
      "resolveJsonModule": true,
      "strict": true,
      "esModuleInterop": true,
      "skipLibCheck": true,
      "forceConsistentCasingInFileNames": true,
      "outDir": "./dist",
      "baseUrl": ".",
      "paths": {
        "@playwright/test": ["node_modules/@playwright/test"]
      },
      "types": ["@playwright/test"]
    },
    "include": [
      "tests/**/*.ts",
      "tests/**/*.d.ts"
    ],
    "exclude": [
      "node_modules",
      "dist"
    ]
  }  